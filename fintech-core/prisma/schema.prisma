// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INVESTOR
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  INVEST
  TRANSFER
  DIVEST
}

enum Currency {
  USD
  EUR
  UAH
}

enum BusinessUnitStatus {
  ACTIVE
  INACTIVE
}

enum InvestmentStatus {
  ACTIVE
  WITHDRAWN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(INVESTOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolios Portfolio[]
}

model Portfolio {
  id          Int          @id @default(autoincrement())
  name        String
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts    Account[]    @relation("PortfolioToAccount")
  investments Investment[] @relation("PortfolioToInvestment")
}

model Account {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  name        String
  type        String
  balance     Decimal  @default(0.00) @db.Decimal(18, 2)
  currency    Currency @default(USD)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio      Portfolio      @relation("PortfolioToAccount", fields: [portfolioId], references: [id])
  journalEntries JournalEntry[] @relation("AccountToJournal")
}

model BusinessUnit {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  currency     Currency @default(USD)
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  interestRate Float
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investments    Investment[]   @relation("BusinessUnitToInvestment")
  journalEntries JournalEntry[] @relation("BusinessUnitToJournal")
}

model Investment {
  id             Int              @id @default(autoincrement())
  portfolioId    Int
  businessUnitId Int
  amount         Decimal          @db.Decimal(18, 2)
  currency       Currency
  status         InvestmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  portfolio      Portfolio      @relation("PortfolioToInvestment", fields: [portfolioId], references: [id], onDelete: Cascade)
  businessUnit   BusinessUnit   @relation("BusinessUnitToInvestment", fields: [businessUnitId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[] @relation("InvestmentToJournal")
}

model JournalEntry {
  id             Int             @id @default(autoincrement())
  amount         Decimal         @db.Decimal(18, 2)
  accountId      Int
  transactionId  String          @default(uuid())
  businessUnitId Int?
  investmentId   Int?
  type           TransactionType @default(TRANSFER)
  description    String?
  createdAt      DateTime        @default(now())

  account      Account       @relation("AccountToJournal", fields: [accountId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation("BusinessUnitToJournal", fields: [businessUnitId], references: [id])
  investment   Investment?   @relation("InvestmentToJournal", fields: [investmentId], references: [id])

  @@index([transactionId])
}
