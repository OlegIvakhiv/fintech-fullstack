// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INVESTOR
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  INVEST
  TRANSFER
  DIVEST  
  CURRENCY_CONVERSION
}

enum Currency {
  USD
  EUR
  UAH
}

enum BusinessUnitStatus {
  ACTIVE
  INACTIVE
}

enum InvestmentStatus {
  ACTIVE
  WITHDRAWN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalType {
  BUSINESS_UNIT_TO_ACCOUNT
  BUSINESS_UNIT_TO_BUSINESS_UNIT
  ACCOUNT_TO_EXTERNAL
}

enum WithdrawalMethod {
  CRYPTO
  BANK_TRANSFER
  CASH
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(INVESTOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolios                   Portfolio[]
  withdrawalRequestsAsInvestor WithdrawalRequest[] @relation("InvestorRequests")
  withdrawalRequestsAsAdmin    WithdrawalRequest[] @relation("AdminApproval")
}

model Portfolio {
  id          Int          @id @default(autoincrement())
  name        String
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts    Account[]    @relation("PortfolioToAccount")
  investments Investment[] @relation("PortfolioToInvestment")
}

model Account {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  name        String
  type        String
  balance     Decimal  @default(0.00) @db.Decimal(18, 8)
  currency    Currency @default(USD)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // null = active, set = soft-deleted

  portfolio          Portfolio           @relation("PortfolioToAccount", fields: [portfolioId], references: [id])
  journalEntries     JournalEntry[]      @relation("AccountToJournal")
  withdrawalRequests WithdrawalRequest[]
  fundInvestments    FundInvestment[]
}

model BusinessUnit {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  currency     Currency @default(USD)
  balance      Decimal  @default(0) @db.Decimal(18, 8)
  
  monthlyROI   Float?   // Current month's ROI percentage (e.g., 1.5 means 1.5%)
  annualROI    Float? 
  interestRate Float
  
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastROIUpdate DateTime? 

  roiHistory         BusinessUnitROI[] @relation("BusinessUnitToROI")

  investments            Investment[]        @relation("BusinessUnitToInvestment")
  journalEntries         JournalEntry[]      @relation("BusinessUnitToJournal")
  withdrawalRequests     WithdrawalRequest[] @relation("WithdrawalRequestsFrom")
  withdrawalRequestsTo   WithdrawalRequest[] @relation("WithdrawalRequestsTo")
  fundAllocations        FundAllocation[]
}

model BusinessUnitROI {
  id             Int          @id @default(autoincrement())
  businessUnitId Int
  month          Int
  year           Int
  monthlyROI     Float
  totalPoolValue   Decimal    @default(0) @db.Decimal(18, 8)
  totalDistributed Decimal    @default(0) @db.Decimal(18, 8)
  currency       Currency     @default(USD)  // snapshot at creation time
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  businessUnit   BusinessUnit @relation("BusinessUnitToROI", fields: [businessUnitId], references: [id])

  @@unique([businessUnitId, month, year])
}


model Fund {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  currency    String   @default("USD")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allocations  FundAllocation[]
  investments  FundInvestment[]
}

model FundAllocation {
  id             Int  @id @default(autoincrement())
  fundId         Int
  businessUnitId Int
  weight         Float  // percentage, e.g. 40.0 means 40%

  fund         Fund         @relation(fields: [fundId], references: [id])
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])

  @@unique([fundId, businessUnitId])
}

model FundInvestment {
  id        Int      @id @default(autoincrement())
  fundId    Int
  accountId Int
  amount    Float
  status    String   @default("ACTIVE")  // ACTIVE | WITHDRAWN
  createdAt DateTime @default(now())

  fund    Fund    @relation(fields: [fundId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}


model Investment {
  id             Int              @id @default(autoincrement())
  portfolioId    Int
  businessUnitId Int
  amount         Decimal          @db.Decimal(18, 8)
  currency       Currency
  status         InvestmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  portfolio      Portfolio      @relation("PortfolioToInvestment", fields: [portfolioId], references: [id], onDelete: Cascade)
  businessUnit   BusinessUnit   @relation("BusinessUnitToInvestment", fields: [businessUnitId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[] @relation("InvestmentToJournal")
}

model WithdrawalRequest {
  id             Int             @id @default(autoincrement())
  investorId     Int
  accountId      Int
  
  withdrawalType WithdrawalType
  
  fromBusinessUnitId Int?
  toBusinessUnitId   Int?
  
  externalWallet     String?
  withdrawalMethod   WithdrawalMethod?
  
  amount         Decimal       @db.Decimal(18, 8)
  currency       Currency
  status         RequestStatus @default(PENDING)
  requestedAt    DateTime      @default(now())
  processedAt    DateTime?
  adminId        Int?
  transactionId  String?
  description    String?
  
  investor             User         @relation("InvestorRequests", fields: [investorId], references: [id], onDelete: Cascade)
  account              Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  fromBusinessUnit     BusinessUnit? @relation("WithdrawalRequestsFrom", fields: [fromBusinessUnitId], references: [id], onDelete: Restrict)
  toBusinessUnit       BusinessUnit? @relation("WithdrawalRequestsTo", fields: [toBusinessUnitId], references: [id], onDelete: Restrict)
  admin                User?        @relation("AdminApproval", fields: [adminId], references: [id])

  @@index([investorId])
  @@index([status])
  @@index([withdrawalType])
}

model JournalEntry {
  id             Int             @id @default(autoincrement())
  amount         Decimal         @db.Decimal(18, 8)
  accountId      Int
  transactionId  String          @default(uuid())
  businessUnitId Int?
  investmentId   Int?
  type           TransactionType @default(TRANSFER)
  currency       Currency?       
  description    String?
  createdAt      DateTime        @default(now())

  account      Account       @relation("AccountToJournal", fields: [accountId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation("BusinessUnitToJournal", fields: [businessUnitId], references: [id])
  investment   Investment?   @relation("InvestmentToJournal", fields: [investmentId], references: [id])

  @@index([transactionId])
}


